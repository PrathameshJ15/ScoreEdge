# Environment Variables Example for ScoreEdge - SPPU Exam Intelligence Platform

# Database (Supabase / PostgreSQL)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Razorpay / Payment Credentials
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxx
RAZORPAY_KEY_SECRET=xxxxxx
RAZORPAY_WEBHOOK_SECRET=xxxxxx

# ==============================================================================
# AI Provider Configuration (Groq / OpenAI / Mock)
# ==============================================================================
# AI_PROVIDER: 'groq' | 'openai' | 'mock'
# If GROQ_API_KEY is provided, it automatically defaults to Groq for lightning-fast answers!
AI_PROVIDER=groq

# Groq Cloud API (Recommended: Free & Ultra-fast LPU inference)
# Get your free key at: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# OpenAI Cloud API (Optional alternative)
OPENAI_API_KEY=sk-xxxxxx
OPENAI_MODEL=gpt-4o-mini

# App Config
NEXT_PUBLIC_APP_URL=http://localhost:3000

DATABASE_URL="postgresql://neondb_owner:npg_rdTj3lWv1xYJ@ep-winter-snow-ayjd9rwo-pooler.c-5.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require"
# uncomment next line if you use Prisma <5.10
DATABASE_URL_UNPOOLED="postgresql://neondb_owner:npg_rdTj3lWv1xYJ@ep-winter-snow-ayjd9rwo.c-5.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require"